# Copiá este archivo como .env.local y completá los valores.
# Nunca subas .env.local al repositorio.

# Dominio público (sin barra final). Se usa en SEO, sitemap, Open Graph y mensajes de WhatsApp.
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.com.ar

# Newsletter: URL de un webhook (Brevo, Mailchimp vía Zapier/Make, etc.) que recibe { email, source, at }.
# Sin este valor, el formulario responde que la suscripción todavía no está habilitada.
NEWSLETTER_WEBHOOK_URL=

# Mercado Pago — dejar vacío hasta implementar y probar la integración (ver src/lib/payments/server.ts).
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_ENABLED=false
